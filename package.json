{
  "name": "@newyolk/expo",
  "version": "1.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "build-development-android-local": "eas build --profile development --platform android --local",
    "build-development-android-remote": "eas build --profile development --platform android",
    "build-development-ios-local": "eas build --profile development-simulator --platform ios --local",
    "build-development-ios-local-device": "eas build --platform ios --profile development --local",
    "build-development-ios-remote": "eas build --profile development --platform ios",
    "clean": "git clean -xdf .expo .turbo node_modules",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "ios": "expo run:ios",
    "secrets-push": "eas secret:push --scope project --env-file ./.env.production",
    "start": "expo start --dev-client --reset-cache",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "web": "expo start --web"
  },
  "dependencies": {
    "@better-auth/expo": "^1.4.19",
    "@expo/metro-runtime": "~55.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-navigation/bottom-tabs": "7.10.1",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.31",
    "@tanstack/react-query": "^5.90.5",
    "@trpc/client": "11.8.0",
    "@trpc/react-query": "11.8.0",
    "@trpc/server": "11.8.0",
    "better-auth": "^1.4.19",
    "clsx": "^2.0.0",
    "date-fns": "4.1.0",
    "decimal.js": "^10.4.3",
    "expo": "~55.0.26",
    "expo-blur": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.15",
    "expo-network": "~55.0.8",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.24",
    "expo-web-browser": "~55.0.16",
    "i18n-js": "^4.5.1",
    "lucide-react-native": "0.552.0",
    "react": "19.2.0",
    "react-async-hook": "^3.6.1",
    "react-native": "0.83.6",
    "react-native-css-interop": "~0.0.13",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-gifted-charts": "1.4.70",
    "react-native-otp-entry": "^1.4.1",
    "react-native-paper": "^5.12.3",
    "react-native-phone-number-input": "^2.1.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "superjson": "1.13.1",
    "tailwind-merge": "3.4.0"
